DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/website_monitor
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
fire_crawler_api=
FIRECRAWL_API_KEY=

# Simple email config. Gmail app passwords work with this setup.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
# For per-source routing, set recipients in mysignal/data/tracked_recursive_roots.json:
# [{"url": "https://example.com/news", "strategy": "parent", "recipients": ["news@example.com"]}]
# [{"url": "https://example.com/feed.xml", "strategy": "feed", "recipients": ["rss@example.com"]}]

# Optional SMTP overrides for non-Gmail providers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
