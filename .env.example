# Required providers. Keep secret values out of source control.
ZENROWS_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.5-flash
AWS_REGION=us-east-1
ENVIRONMENT=prod

# Local Docker development with AWS IAM Identity Center (SSO). These values
# are used only with docker-compose.sso.yml; no AWS credentials belong here.
AWS_PROFILE=actalyst-dev
# Windows example: C:/Users/your-windows-user/.aws
AWS_CONFIG_DIR=
# Windows example: C:/Users/your-windows-user/.aws/sso/cache
AWS_SSO_CACHE_DIR=

# S3 system of record. Production uses STORAGE_BACKEND=s3 and an ECS task role.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_PREFIX=sentinel-actalyst

# Fargate task launch configuration. ECS_NETWORK_CONFIGURATION is JSON.
ECS_CLUSTER=
ECS_TASK_DEFINITION=
ECS_CONTAINER_NAME=worker
ECS_LAUNCH_TYPE=FARGATE
ECS_NETWORK_CONFIGURATION={"awsvpcConfiguration":{"subnets":[],"securityGroups":[],"assignPublicIp":"DISABLED"}}
# Keep ECS in deployed environments. Local Docker can use `local` temporarily.
TASK_EXECUTION_BACKEND=ecs

# EventBridge Scheduler deployment settings.
EVENTBRIDGE_SCHEDULER_GROUP=
EVENTBRIDGE_SCHEDULER_ROLE_ARN=
EVENTBRIDGE_SCHEDULER_TARGET_ARN=

# Session and initial account seed. AUTH_SECRET is mandatory in production.
AUTH_SECRET=
AUTH_COOKIE_SECURE=true
ADMIN_NAME=
ADMIN_PASSWORD=
USER_1_NAME=
USER_1_PASSWORD=

# SES sender (must be a verified identity in the selected SES Region).
SES_FROM_EMAIL=
# Overrides AWS_REGION for SES only, e.g. when the S3 bucket and SES identity
# live in different regions. Defaults to AWS_REGION when unset.
SES_REGION=
# Used only by the legacy command-line monitor. The web app stores recipients per company.
SES_DEFAULT_RECIPIENTS=
SES_CONFIGURATION_SET=

# Provider/pipeline defaults and bounded ZenRows behavior.
DEFAULT_PROCESSING_PIPELINE=auto
ZENROWS_JS_RENDER=true
ZENROWS_TIMEOUT_SECONDS=30
ZENROWS_MAX_RETRIES=3
CRAWL4AI_TIMEOUT_SECONDS=10
# A manual check processes only this many newly discovered URLs at once.
MONITOR_MAX_NEW_URLS=5
MONITOR_URL_CONCURRENCY=3

# Optional preserved provider. This is not required by the ZenRows + Gemini path.
FIRECRAWL_API_KEY=
