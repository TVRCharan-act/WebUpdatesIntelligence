OPENAI_API_KEY=
FIRECRAWL_API_KEY=

# Simple email config. Gmail app passwords work with this setup.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=

# Optional SMTP overrides for non-Gmail providers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
